# Force the in-memory demo GraphQL API even if WorkOS credentials are present.
# Recommended until the Widgets API closed beta is enabled on your account.
WIDGETS_DEMO_MODE=1

# WorkOS AuthKit (required for live mode — leave unset or keep DEMO_MODE=1 until ready)
WORKOS_CLIENT_ID="client_..."
WORKOS_API_KEY="sk_..."
WORKOS_COOKIE_PASSWORD="" # openssl rand -base64 32
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/callback"

# Optional overrides
# NEXT_PUBLIC_WORKOS_GRAPHQL_URL=https://api.workos.com/client/graphql
# WORKOS_CLIENT_TOKEN_URL=https://api.workos.com/client/token
